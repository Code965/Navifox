<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Navifox</AssemblyName>
    <Product>Navifox</Product>
    <ApplicationIcon>Assets\NaviFoxBrand\navifox-dark.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);App\**;Tests\**</DefaultItemExcludes>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="App\**\*.cs;Core\**\*.cs;Dialects\**\*.cs;Tests\**\*.cs" />
    <AvaloniaResource Remove="App\**\*.axaml;Core\**\*.axaml;Dialects\**\*.axaml;Tests\**\*.axaml" />
    <AvaloniaResource Include="Assets\**" />
    <ProjectReference Include="Core\MosaicDB.Core.csproj" />
    <ProjectReference Include="Dialects\MosaicDB.Dialects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
</Project>
