<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DbClient.ViewModels"
        x:Class="DbClient.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Navifox"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource NfBackgroundBrush}">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource NfBackgroundBrush}">
        <Border Grid.Row="0"
                Background="{DynamicResource NfChromeBrush}"
                BorderBrush="{DynamicResource NfBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                <Image Source="{DynamicResource NfLogo}" Width="145" Height="42" Stretch="Uniform" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Database workspace" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource NfTextBrush}" />
                    <TextBlock Text="Connessioni MySQL, MariaDB e PostgreSQL" FontSize="13" Foreground="{DynamicResource NfTextMutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Margin="24"
                Padding="24"
                CornerRadius="10"
                Background="{DynamicResource NfChromeBrush}"
                BorderBrush="{DynamicResource NfBorderBrush}"
                BorderThickness="1">
            <StackPanel Spacing="12">
                <TextBlock Text="Provider database disponibili" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource NfTextBrush}" />
                <TextBlock Text="{Binding DialectSummary}" FontSize="15" Foreground="{DynamicResource NfAccentTextBrush}" />
                <TextBlock Text="I provider condividono l'interfaccia IDialectProvider e sono registrati tramite dependency injection."
                           TextWrapping="Wrap" Foreground="{DynamicResource NfTextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
