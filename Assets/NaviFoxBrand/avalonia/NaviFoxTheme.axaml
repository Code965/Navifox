<!--
  NaviFox — tema chiaro/scuro per Avalonia 11/12.
  Includi in App.axaml:
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceInclude Source="avares://Navifox/Assets/NaviFoxBrand/avalonia/NaviFoxTheme.axaml" />
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Application.Resources>

  Uso:      <Image Source="{DynamicResource NfLogo}" Height="24" />
            <Border Background="{DynamicResource NfChromeBrush}" />
  Cambio tema da codice:
            Application.Current!.RequestedThemeVariant = ThemeVariant.Dark;   // o ThemeVariant.Light / ThemeVariant.Default (segue il sistema)
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="NfBackgroundBrush" Color="#0F1114" />
      <SolidColorBrush x:Key="NfChromeBrush" Color="#15181C" />
      <SolidColorBrush x:Key="NfSurfaceBrush" Color="#1A1D22" />
      <SolidColorBrush x:Key="NfHoverBrush" Color="#22262C" />
      <SolidColorBrush x:Key="NfBorderBrush" Color="#2A2F36" />
      <SolidColorBrush x:Key="NfGridLineBrush" Color="#1E2227" />
      <SolidColorBrush x:Key="NfTextBrush" Color="#E9E7E4" />
