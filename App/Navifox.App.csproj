<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Navifox</AssemblyName>
    <RootNamespace>Navifox.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\NaviFoxBrand\navifox-dark.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.0.0</Version>
    <Product>NaviFox</Product>
    <Company>NaviFox</Company>
    <!-- Sorgente aggiornamenti predefinita (cartella, \\server\condivisione, URL o repository GitHub); lo script di release la sovrascrive. -->
    <NavifoxUpdateSource Condition="'$(NavifoxUpdateSource)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\releases'))</NavifoxUpdateSource>  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NavifoxUpdateSource" Value="$(NavifoxUpdateSource)" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\Assets\NaviFoxBrand\**\*.*" Link="Assets\NaviFoxBrand\%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="..\Core\Navifox.Core.csproj" />
    <ProjectReference Include="..\Dialects\Navifox.Dialects.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.8" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.8" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>
</Project>
