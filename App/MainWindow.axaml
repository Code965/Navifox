<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Navifox.App.ViewModels"
        xmlns:views="using:Navifox.App.Views"
        xmlns:c="using:Navifox.App.Controls"
        x:Class="Navifox.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Navifox" Width="960" Height="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:TableTabViewModel">
      <views:TablePageView />
    </DataTemplate>
    <DataTemplate DataType="vm:TableDesignerViewModel"><views:TableDesignerView /></DataTemplate>
    <DataTemplate DataType="vm:SchemaObjectEditorViewModel"><views:SchemaObjectEditorView /></DataTemplate>
    <DataTemplate DataType="vm:SequenceEditorViewModel"><views:SequenceEditorView /></DataTemplate>
    <DataTemplate DataType="vm:SyncTabViewModel"><views:SyncView /></DataTemplate>
    <DataTemplate DataType="vm:UsersTabViewModel"><views:UsersView /></DataTemplate>
    <DataTemplate DataType="vm:QueryTabViewModel">
      <views:QueryPageView />
    </DataTemplate>
    <DataTemplate DataType="vm:ModelTabViewModel"><views:ModelPageView /></DataTemplate>
    <DataTemplate DataType="vm:ServerMonitorViewModel"><views:ServerMonitorView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryTabViewModel"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:FindTabViewModel"><views:FindView /></DataTemplate>
    <DataTemplate DataType="vm:AutomationTabViewModel"><views:AutomationView /></DataTemplate>
    <DataTemplate DataType="vm:ObjectsTabViewModel">
      <views:ObjectsView />
    </DataTemplate>
  </Window.DataTemplates>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding ToggleTreeCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+I" Command="{Binding ToggleInfoCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding OpenConsoleCommand}" CommandParameter="{x:Null}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding OpenHistoryCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding OpenFindCommand}" CommandParameter="{x:Null}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCurrentTabCommand}" />
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" CommandParameter="next" />
    <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding NextTabCommand}" CommandParameter="prev" />
    <KeyBinding Gesture="Ctrl+Shift+PageUp" Command="{Binding MoveSelectedTabCommand}" CommandParameter="left" />
    <KeyBinding Gesture="Ctrl+Shift+PageDown" Command="{Binding MoveSelectedTabCommand}" CommandParameter="right" />
    <KeyBinding Gesture="Ctrl+P" Command="{Binding OpenPaletteCommand}" />
  </Window.KeyBindings>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Barra titolo: logo + menu -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0,8,0" Height="38">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Image Source="{DynamicResource NfLogo}" Height="20" VerticalAlignment="Center" ToolTip.Tip="NaviFox" />
        <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" Classes="top-menu">
          <MenuItem Header="File">
            <MenuItem Header="Apri area di lavoro…" Command="{Binding OpenWorkspaceCommand}"><MenuItem.Icon><c:NfIcon Kind="folder" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Salva area di lavoro…" Command="{Binding SaveWorkspaceCommand}" ToolTip.Tip="Salva le schede aperte (tabelle e query) in un file .nfx"><MenuItem.Icon><c:NfIcon Kind="save" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Nuova connessione">
              <MenuItem.Icon><c:NfIcon Kind="plus" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="MySQL…" Command="{Binding AddConnectionWithDriverCommand}" CommandParameter="MySQL" />
              <MenuItem Header="MariaDB…" Command="{Binding AddConnectionWithDriverCommand}" CommandParameter="MariaDB" />
              <MenuItem Header="PostgreSQL…" Command="{Binding AddConnectionWithDriverCommand}" CommandParameter="PostgreSQL" />
              <MenuItem Header="Supabase…" Command="{Binding AddConnectionWithDriverCommand}" CommandParameter="Supabase" />
              <Separator />
              <MenuItem Header="Tutti i database…" Command="{Binding AddConnectionCommand}" />
            </MenuItem>
            <MenuItem Header="Nuovo">
              <MenuItem.Icon><c:NfIcon Kind="file-code" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="Query" Command="{Binding NewQueryCommand}" CommandParameter="{x:Null}" />
              <MenuItem Header="Tabella" Command="{Binding NewTableCommand}" CommandParameter="{x:Null}" />
              <MenuItem Header="Database…" Command="{Binding NewDatabaseCommand}" CommandParameter="{Binding SelectedNode}" />
            </MenuItem>
            <MenuItem Header="Apri file esterno">
              <MenuItem.Icon><c:NfIcon Kind="folder" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="File SQL…" Command="{Binding OpenExternalSqlCommand}" />
              <MenuItem Header="Esegui file SQL…" Command="{Binding ExecuteSqlFileCommand}" CommandParameter="{Binding SelectedNode}" />
            </MenuItem>
            <MenuItem x:Name="RecentMenu" Header="Apri recenti">
              <MenuItem.Icon><c:NfIcon Kind="history" Classes="menu-icon" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Chiudi connessione" Command="{Binding DisconnectSelectedCommand}"><MenuItem.Icon><c:NfIcon Kind="unplug" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Modifica connessione…" Command="{Binding EditConnectionCommand}" CommandParameter="{Binding SelectedNode}" InputGesture="F2"><MenuItem.Icon><c:NfIcon Kind="pencil" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Elimina connessione…" Command="{Binding DeleteSelectedConnectionCommand}" InputGesture="Delete"><MenuItem.Icon><c:NfIcon Kind="trash" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Nuova cartella…" Command="{Binding NewFolderCommand}" CommandParameter="{x:Null}"><MenuItem.Icon><c:NfIcon Kind="folder" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Importa connessioni…" Command="{Binding ImportConnectionsCommand}"><MenuItem.Icon><c:NfIcon Kind="import" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Esporta connessioni…" Command="{Binding ExportConnectionsCommand}"><MenuItem.Icon><c:NfIcon Kind="export" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Chiudi finestra" Command="{Binding ExitCommand}" />
            <MenuItem Header="Chiudi scheda" Command="{Binding CloseCurrentTabCommand}" InputGesture="Ctrl+W" />
            <MenuItem Header="Esci da Navifox" Command="{Binding ExitCommand}" />
          </MenuItem>
          <MenuItem Header="Modifica"><MenuItem Header="Annulla operazione" Command="{Binding CancelOperationCommand}"><MenuItem.Icon><c:NfIcon Kind="stop" /></MenuItem.Icon></MenuItem></MenuItem>
          <MenuItem Header="Visualizza">
            <MenuItem Header="Pannello di navigazione">
              <MenuItem.Icon><c:NfIcon Kind="panel-left" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="Mostra pannello di navigazione" ToggleType="CheckBox" IsChecked="{Binding IsTreeVisible, Mode=TwoWay}" InputGesture="Ctrl+Shift+L" />
            </MenuItem>
            <MenuItem Header="Pannello informazioni">
              <MenuItem.Icon><c:NfIcon Kind="panel-right" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="Mostra pannello informazioni" ToggleType="CheckBox" IsChecked="{Binding IsInfoVisible, Mode=TwoWay}" InputGesture="Ctrl+Shift+I" />
              <Separator />
              <MenuItem Header="Informazioni" Command="{Binding ShowInfoSectionCommand}" CommandParameter="info" />
              <MenuItem Header="DDL" Command="{Binding ShowInfoSectionCommand}" CommandParameter="ddl" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Elenco" ToggleType="Radio" GroupName="objview" IsChecked="{Binding ObjectsTab.IsListMode, Mode=OneWay}" Command="{Binding SetObjectsViewCommand}" CommandParameter="list" />
            <MenuItem Header="Dettaglio" ToggleType="Radio" GroupName="objview" IsChecked="{Binding ObjectsTab.IsDetailMode, Mode=OneWay}" Command="{Binding SetObjectsViewCommand}" CommandParameter="detail" />
            <MenuItem Header="Diagramma ER" Command="{Binding SetObjectsViewCommand}" CommandParameter="er"><MenuItem.Icon><c:NfIcon Kind="network" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Appiattisci elenco oggetti" ToggleType="CheckBox" IsChecked="{Binding IsFlatObjectList, Mode=TwoWay}" ToolTip.Tip="Mostra tabelle e viste insieme nell'elenco degli oggetti" />
            <MenuItem Header="Ordina">
              <MenuItem.Icon><c:NfIcon Kind="sort" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="Per nome" Command="{Binding SortObjectsCommand}" CommandParameter="Nome" />
              <MenuItem Header="Per numero di righe" Command="{Binding SortObjectsCommand}" CommandParameter="Righe" />
              <MenuItem Header="Per dimensione dati" Command="{Binding SortObjectsCommand}" CommandParameter="Dimensione dati" />
              <MenuItem Header="Per data di modifica" Command="{Binding SortObjectsCommand}" CommandParameter="Data modifica" />
              <MenuItem Header="Per Auto Increment" Command="{Binding SortObjectsCommand}" CommandParameter="Auto Increment" />
              <MenuItem Header="Per tipo" Command="{Binding SortObjectsCommand}" CommandParameter="Tipo" />
            </MenuItem>
            <MenuItem Header="Scegli colonne">
              <MenuItem.Icon><c:NfIcon Kind="column" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="Auto Increment" ToggleType="CheckBox" IsChecked="True" Command="{Binding ToggleObjectColumnCommand}" CommandParameter="Auto Increment" />
              <MenuItem Header="Data modifica" ToggleType="CheckBox" IsChecked="True" Command="{Binding ToggleObjectColumnCommand}" CommandParameter="Data modifica" />
              <MenuItem Header="Dimensione dati" ToggleType="CheckBox" IsChecked="True" Command="{Binding ToggleObjectColumnCommand}" CommandParameter="Dimensione dati" />
              <MenuItem Header="Engine" ToggleType="CheckBox" IsChecked="True" Command="{Binding ToggleObjectColumnCommand}" CommandParameter="Engine" />
              <MenuItem Header="Righe" ToggleType="CheckBox" IsChecked="True" Command="{Binding ToggleObjectColumnCommand}" CommandParameter="Righe" />
              <MenuItem Header="Commento" ToggleType="CheckBox" IsChecked="True" Command="{Binding ToggleObjectColumnCommand}" CommandParameter="Commento" />
            </MenuItem>
            <Separator />
            <MenuItem Header="Tema chiaro / scuro" Command="{Binding ToggleThemeCommand}"><MenuItem.Icon><c:NfIcon Kind="sun-moon" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
          </MenuItem>
          <MenuItem x:Name="FavoritesMenu" Header="Preferiti" />
          <MenuItem Header="Strumenti">
            <MenuItem Header="Trasferimento dati…" Command="{Binding OpenDataTransferCommand}" CommandParameter="{x:Null}"><MenuItem.Icon><c:NfIcon Kind="transfer" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Sincronizzazione dati…" Command="{Binding OpenDataSyncCommand}" CommandParameter="{x:Null}"><MenuItem.Icon><c:NfIcon Kind="sync" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Sincronizzazione struttura…" Command="{Binding OpenStructureSyncCommand}" CommandParameter="{x:Null}"><MenuItem.Icon><c:NfIcon Kind="layers" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Console…" Command="{Binding OpenConsoleCommand}" CommandParameter="{x:Null}" InputGesture="F6"><MenuItem.Icon><c:NfIcon Kind="terminal" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Server Monitor">
              <MenuItem.Icon><c:NfIcon Kind="activity" Classes="menu-icon" /></MenuItem.Icon>
              <MenuItem Header="Tutti i server" Command="{Binding OpenServerMonitorCommand}" CommandParameter="{x:Null}" />
            </MenuItem>
            <MenuItem Header="Trova nel database/schema…" Command="{Binding OpenFindCommand}" CommandParameter="{x:Null}" InputGesture="Ctrl+Shift+F"><MenuItem.Icon><c:NfIcon Kind="search" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Registro attività…" Command="{Binding OpenHistoryCommand}" InputGesture="Ctrl+L"><MenuItem.Icon><c:NfIcon Kind="history" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Automazione…" Command="{Binding OpenAutomationCommand}"><MenuItem.Icon><c:NfIcon Kind="workflow" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Opzioni…" Command="{Binding OpenOptionsCommand}"><MenuItem.Icon><c:NfIcon Kind="settings" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
          </MenuItem>
          <MenuItem Header="Finestra">
            <MenuItem Header="Oggetti" Command="{Binding ShowCategoryCommand}" CommandParameter="Tabelle"><MenuItem.Icon><c:NfIcon Kind="list" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Chiudi scheda" Command="{Binding CloseCurrentTabCommand}" InputGesture="Ctrl+W" />
            <MenuItem Header="Chiudi tutte le schede" Command="{Binding CloseAllTabsCommand}" />
          </MenuItem>
          <MenuItem Header="Aiuto">
            <MenuItem Header="Guida in linea" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding HelpUrl}"><MenuItem.Icon><c:NfIcon Kind="book" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Scorciatoie da tastiera…" Command="{Binding ShowShortcutsCommand}"><MenuItem.Icon><c:NfIcon Kind="keyboard" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Novità delle versioni" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding ReleasesUrl}" />
            <MenuItem Header="Segnala un problema…" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding IssuesUrl}"><MenuItem.Icon><c:NfIcon Kind="bug" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="Verifica aggiornamenti…" Command="{Binding CheckUpdatesCommand}"><MenuItem.Icon><c:NfIcon Kind="download" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="Informazioni su Navifox" Command="{Binding ShowAboutCommand}"><MenuItem.Icon><c:NfIcon Kind="info" Classes="menu-icon" /></MenuItem.Icon></MenuItem>
          </MenuItem>
        </Menu>
        <Button Grid.Column="2" Classes="tb-icon" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Tema chiaro / scuro">
          <c:NfIcon Kind="sun-moon" />
        </Button>
      </Grid>
    </Border>

    <!-- Toolbar snella con icone lineari -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <Button Classes="tb primary" Command="{Binding AddConnectionCommand}" ToolTip.Tip="Nuova connessione">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="plus" /><TextBlock Text="Connessione" /></StackPanel>
          </Button>
          <Button Classes="tb" Command="{Binding NewQueryCommand}" ToolTip.Tip="Nuova query sul database selezionato">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="file-code" /><TextBlock Text="Nuova query" /></StackPanel>
          </Button>
          <Border Classes="tb-sep" />
          <Button Classes="tb" Classes.active="{Binding IsTablesActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Tabelle">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="table" /><TextBlock Text="Tabelle" /></StackPanel>
          </Button>
          <Button Classes="tb" Classes.active="{Binding IsViewsActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Viste">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="eye" /><TextBlock Text="Viste" /></StackPanel>
          </Button>
          <Button Classes="tb" Classes.active="{Binding IsFunctionsActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Funzioni">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="function" /><TextBlock Text="Funzioni" /></StackPanel>
          </Button>
          <Button Classes="tb" Classes.active="{Binding IsEventsActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Eventi">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="clock" /><TextBlock Text="Eventi" /></StackPanel>
          </Button>
          <Button Classes="tb" Classes.active="{Binding IsTriggersActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Trigger">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="zap" /><TextBlock Text="Trigger" /></StackPanel>
          </Button>
          <Button Classes="tb" Classes.active="{Binding IsSequencesActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Sequenze">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="hash" /><TextBlock Text="Sequenze" /></StackPanel>
          </Button>
          <Border Classes="tb-sep" />
          <Button Classes="tb" Classes.active="{Binding IsUsersActive}" Command="{Binding OpenUsersCommand}" CommandParameter="{x:Null}" ToolTip.Tip="Utenti e privilegi del server">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="users" /><TextBlock Text="Utenti" /></StackPanel>
          </Button>
          <Button Classes="tb" Classes.active="{Binding IsQueriesActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Query salvate">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="bookmark" /><TextBlock Text="Query" /></StackPanel>
          </Button>
          <Button Classes="tb" Classes.active="{Binding IsBackupActive}" Command="{Binding ShowCategoryCommand}" CommandParameter="Backup">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="archive" /><TextBlock Text="Backup" /></StackPanel>
          </Button>
          <Border Classes="tb-sep" />
          <Button Classes="tb" Command="{Binding OpenAutomationCommand}" ToolTip.Tip="Attività pianificate: query, dump ed export automatici">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="workflow" /><TextBlock Text="Automazione" /></StackPanel>
          </Button>
          <Button Classes="tb" Command="{Binding OpenModelCommand}" CommandParameter="{x:Null}" ToolTip.Tip="Modello relazionale del database selezionato">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="network" /><TextBlock Text="Modello" /></StackPanel>
          </Button>
          <Button Classes="tb" Command="{Binding OpenServerMonitorCommand}" CommandParameter="{x:Null}" ToolTip.Tip="Processi, variabili e stato del server">
            <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="activity" /><TextBlock Text="Monitor" /></StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid x:Name="MainGrid" Grid.Row="2" ColumnDefinitions="280,6,*,6,300" Margin="10,10,10,8">
      <!-- Pannello connessioni: connessione → database → (schema) → categorie → tabelle -->
      <Border Grid.Column="0" IsVisible="{Binding IsTreeVisible}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*" Margin="10,10,6,8">
            <TextBlock Text="Connessioni" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Row="1" Margin="8,0,8,6">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="Cerca connessioni, database, tabelle" Padding="28,5,26,5" MinHeight="28" FontSize="12">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding ClearTreeFilterCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <c:NfIcon Kind="search" Width="14" Height="14" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
            <Button Content="✕" Classes="tree-tool" HorizontalAlignment="Right" Margin="0,0,2,0" IsVisible="{Binding HasTreeFilter}" Command="{Binding ClearTreeFilterCommand}" ToolTip.Tip="Cancella filtro (Esc)" />
          </Grid>
          <TreeView x:Name="ConnectionTree" Grid.Row="2" ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="Transparent" Margin="0,0,0,4">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2">
                  <c:NfIcon Kind="{Binding Glyph}" Classes="tree-icon" Classes.open="{Binding IsLoaded}" Classes.connection="{Binding IsConnection}" Width="15" Height="15" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Name}" Classes="tree-label" Classes.placeholder="{Binding IsPlaceholder}" Classes.connection="{Binding IsConnection}" VerticalAlignment="Center" />
                      <c:DialectBadge Profile="{Binding Profile}" ShowName="True" IsVisible="{Binding IsConnection}" />
                      <Border Classes="env-chip" IsVisible="{Binding Profile, Converter={x:Static c:DialectVisuals.HasEnvironmentConverter}}"
                              Background="{Binding Profile, Converter={x:Static c:DialectVisuals.ProfileColorConverter}}">
                        <TextBlock Text="{Binding Profile, Converter={x:Static c:DialectVisuals.EnvironmentLabelConverter}}" />
                      </Border>
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="28" Height="2" MinWidth="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Connessione: host e porta su una seconda riga, piccola -->
                    <TextBlock Text="{Binding Profile, Converter={x:Static c:DialectVisuals.EndpointConverter}}" IsVisible="{Binding IsConnection}"
                               FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0" />
                  </StackPanel>
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" IsVisible="{Binding IsTreeVisible}" />

      <!-- Area di lavoro a schede: «Oggetti» fissa + tabelle aperte -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
          <TabControl x:Name="WorkspaceTabs" ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" Classes="workspace" Padding="0">
            <TabControl.ItemTemplate>
              <DataTemplate DataType="vm:WorkspaceTabViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Width="4" Height="16" CornerRadius="2" VerticalAlignment="Center" Background="{Binding TabConnection, Converter={x:Static c:DialectVisuals.ProfileColorConverter}}"
                          IsVisible="{Binding TabConnection, Converter={x:Static c:DialectVisuals.HasColorConverter}}" />
                  <c:NfIcon Kind="{Binding TabGlyph}" Foreground="{DynamicResource AccentBrush}" Width="14" Height="14" />
                  <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center" />
                  <Border Classes="env-chip prod" IsVisible="{Binding TabConnection, Converter={x:Static c:DialectVisuals.IsProductionConverter}}">
                    <TextBlock Text="PROD" />
                  </Border>
                  <Button Content="×" Classes="tab-close" IsVisible="{Binding CanClose}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseTabCommand}" CommandParameter="{Binding .}" />
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>

          <Border IsVisible="{Binding ShowWelcome}" Background="{DynamicResource InsetBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="17" MaxWidth="560" Margin="24">
              <Border Width="72" Height="72" Background="{DynamicResource AccentSoftBrush}" CornerRadius="20" HorizontalAlignment="Center">
                <Image Source="{DynamicResource NfMark}" Width="44" Height="44" Stretch="Uniform" />
              </Border>
              <TextBlock Text="Il tuo spazio dati, in un unico posto" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock Text="Collega MySQL, MariaDB o PostgreSQL per esplorare database, schemi e tabelle. Apri più tabelle affiancate nel tuo flusso di lavoro." FontSize="15" Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="23" />
              <Button Content="＋  Aggiungi una connessione" Command="{Binding AddConnectionCommand}" Classes="welcome-button" HorizontalAlignment="Center" Padding="18,11" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Pannello informazioni -->
      <GridSplitter Grid.Column="3" Width="6" Background="Transparent" ResizeDirection="Columns" IsVisible="{Binding IsInfoVisible}" />
      <Border Grid.Column="4" IsVisible="{Binding IsInfoVisible}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <views:InfoPanelView DataContext="{Binding Info}" />
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="20">
        <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="#45A989" VerticalAlignment="Center" /><TextBlock Text="{Binding ConnectionCount}" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="connessioni attive" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ActiveContext}" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Button Grid.Column="2" Classes="update-pill" HorizontalAlignment="Right" IsVisible="{Binding IsUpdateReady}" Command="{Binding ApplyUpdateCommand}" Margin="0,-4">
          <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="download" Width="13" Height="13" /><TextBlock Text="{Binding UpdateLabel}" /></StackPanel>
        </Button>
        <TextBlock Grid.Column="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
        <TextBlock Grid.Column="4" Text="{Binding ElapsedTime}" Foreground="{DynamicResource MutedTextBrush}" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" Margin="-8,-4">
          <ToggleButton Classes="panel-toggle" IsChecked="{Binding IsTreeVisible, Mode=TwoWay}" ToolTip.Tip="Mostra/nascondi il pannello connessioni (Ctrl+Maiusc+L)">
            <c:NfIcon Kind="panel-left" Width="15" Height="15" />
          </ToggleButton>
          <ToggleButton Classes="panel-toggle" IsChecked="{Binding IsInfoVisible, Mode=TwoWay}" ToolTip.Tip="Mostra/nascondi il pannello informazioni (Ctrl+Maiusc+I)">
            <c:NfIcon Kind="panel-right" Width="15" Height="15" />
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Notifiche ═══ -->
    <ItemsControl Grid.RowSpan="4" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,46" ZIndex="90" Width="340">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ToastMessage">
          <Border Classes="toast" Classes.error="{Binding IsError}" Margin="0,6,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <Border Classes="toast-icon" Classes.error="{Binding IsError}" VerticalAlignment="Top">
                <c:NfIcon Kind="{Binding Glyph}" Width="13" Height="13" Foreground="White" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Classes="tab-close" Content="×" VerticalAlignment="Top"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DismissToastCommand}" CommandParameter="{Binding .}" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ═══ Barra comandi (Ctrl+K) ═══ -->
    <Border x:Name="PaletteOverlay" Grid.RowSpan="4" IsVisible="{Binding IsPaletteOpen}" Background="#66000000" ZIndex="100">
      <Border Classes="palette" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0" Width="640">
        <Grid RowDefinitions="Auto,Auto,*,Auto" MaxHeight="520">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="14,10">
            <c:NfIcon Kind="search" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBox x:Name="PaletteBox" Grid.Column="1" Classes="palette-input" Text="{Binding PaletteQuery, Mode=TwoWay}"
                     Watermark="Cerca comandi, connessioni, database, tabelle, funzioni…" />
          </Grid>
          <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" />
          <ListBox x:Name="PaletteList" Grid.Row="2" ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding SelectedPaletteItem, Mode=TwoWay}"
                   Background="Transparent" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,5" /><Setter Property="CornerRadius" Value="6" /></Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PaletteItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <c:NfIcon Kind="{Binding Glyph}" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Classes="kbd" IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="{Binding Shortcut}" /></Border>
                    <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="3" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,6" CornerRadius="0,0,12,12">
            <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Text="↑↓ per scegliere · Invio per aprire · Esc per chiudere" />
          </Border>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
