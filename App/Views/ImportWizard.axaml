<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Navifox.App.ViewModels"
        x:Class="Navifox.App.Views.ImportWizard"
        x:DataType="vm:ImportWizardViewModel"
        Title="Import Wizard" Width="820" Height="620" MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
          <TextBlock Text="⇣" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding StepTitle}" FontSize="16" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,14,20,10">
      <!-- 1. Formato -->
      <StackPanel IsVisible="{Binding IsStep1}" Spacing="6">
        <TextBlock Text="Formato di import:" Classes="field-label" Margin="0,0,0,4" />
        <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}" Background="Transparent" Classes="format-list">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ImportFormatOption">
              <StackPanel Orientation="Horizontal" Spacing="10" Opacity="{Binding IsAvailable, Converter={x:Static vm:WizardConverters.AvailableOpacity}}">
                <Border Width="14" Height="14" CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                  <Ellipse Classes="radio-dot" Width="6" Height="6" />
                </Border>
                <TextBlock Text="{Binding Glyph}" Width="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <!-- 2. File, opzioni e anteprima -->
      <Grid IsVisible="{Binding IsStep2}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <StackPanel Spacing="5">
          <TextBlock Text="File da importare" Classes="field-label" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding Path, Mode=TwoWay}" Watermark="Seleziona un file…" />
            <Button Grid.Column="1" Content="Sfoglia…" Classes="small-muted" Command="{Binding BrowseCommand}" />
          </Grid>
        </StackPanel>
        <WrapPanel Grid.Row="1" Orientation="Horizontal">
          <StackPanel Spacing="5" Width="170" Margin="0,0,12,6" IsVisible="{Binding IsDelimited}">
            <TextBlock Text="Delimitatore" Classes="field-label" />
            <ComboBox ItemsSource="{Binding Delimiters}" SelectedItem="{Binding SelectedDelimiter, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="5" Width="120" Margin="0,0,12,6" IsVisible="{Binding IsDelimited}">
            <TextBlock Text="Qualificatore" Classes="field-label" />
            <ComboBox ItemsSource="{Binding Qualifiers}" SelectedItem="{Binding SelectedQualifier, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="5" Width="150" Margin="0,0,12,6" IsVisible="{Binding IsDelimited}">
            <TextBlock Text="Codifica" Classes="field-label" />
            <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding SelectedEncoding, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="5" Width="200" Margin="0,0,12,6" IsVisible="{Binding IsExcel}">
            <TextBlock Text="Foglio" Classes="field-label" />
            <ComboBox ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="5" Width="120" Margin="0,0,12,6" IsVisible="{Binding HasHeaderOption}">
            <TextBlock Text="Righe da saltare" Classes="field-label" />
            <NumericUpDown Value="{Binding SkipRows}" Minimum="0" Maximum="1000" FormatString="0" />
          </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
          <CheckBox Content="La prima riga contiene i nomi dei campi" IsChecked="{Binding FirstRowIsHeader}" IsVisible="{Binding HasHeaderOption}" />
          <TextBlock Grid.Column="1" Text="{Binding PreviewInfo}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
          <DataGrid x:Name="PreviewGrid" Classes="nf-grid" ItemsSource="{Binding PreviewRows}" AutoGenerateColumns="False" IsReadOnly="True" />
        </Border>
      </Grid>

      <!-- 3. Mappatura -->
      <Grid IsVisible="{Binding IsStep3}" RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <TextBlock Text="Colonna di destinazione ← campo sorgente" Classes="field-label" VerticalAlignment="Center" />
          <Button Content="Associa per nome" Classes="objbar" Command="{Binding AutoMapCommand}" />
          <Button Content="Azzera" Classes="objbar" Command="{Binding ClearMappingCommand}" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
          <ListBox ItemsSource="{Binding Mappings}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ColumnMapping">
                <Grid ColumnDefinitions="200,*,240" ColumnSpacing="10">
                  <TextBlock Text="{Binding Target}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding TargetType}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <ComboBox Grid.Column="2" ItemsSource="{Binding SourceFields}" SelectedItem="{Binding Source, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>

      <!-- 4. Modalità -->
      <StackPanel IsVisible="{Binding IsStep4}" Spacing="12">
        <TextBlock Text="Modalità" Classes="field-label" />
        <RadioButton GroupName="mode" Content="Aggiungi: inserisci i record dopo quelli esistenti" IsChecked="{Binding !ReplaceExisting}" />
        <RadioButton GroupName="mode" Content="Copia: svuota la tabella e inserisci i record" IsChecked="{Binding ReplaceExisting, Mode=TwoWay}" />
        <Separator />
        <CheckBox Content="Tratta i campi vuoti come NULL" IsChecked="{Binding EmptyAsNull}" />
        <CheckBox Content="Continua in caso di errore (salta le righe non valide)" IsChecked="{Binding ContinueOnError}" />
        <CheckBox Content="Esegui tutto in una transazione (annulla tutto se l’import non va a buon fine)" IsChecked="{Binding UseTransaction}" />
        <StackPanel Spacing="5" Width="200" HorizontalAlignment="Left">
          <TextBlock Text="Righe per blocco INSERT" Classes="field-label" />
          <NumericUpDown Value="{Binding BatchSize}" Minimum="1" Maximum="5000" Increment="100" FormatString="0" />
        </StackPanel>
      </StackPanel>

      <!-- 5. Avvio -->
      <Grid IsVisible="{Binding IsStep5}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
        <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
          <SelectableTextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
        </Border>
        <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsRunning}" Height="6" Value="{Binding IsFinished, Converter={x:Static vm:WizardConverters.FinishedProgress}}" />
        <TextBlock Grid.Row="2" Text="{Binding ProgressText}" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
          <ListBox ItemsSource="{Binding Log}" Background="Transparent" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="‹ Indietro" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
        <Button Grid.Column="2" Content="Avanti ›" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" IsVisible="{Binding !IsLastStep}" />
        <Button Grid.Column="3" Content="Avvia" Classes="dialog-primary" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding StartCommand}" IsVisible="{Binding IsLastStep}" IsEnabled="{Binding !IsRunning}" />
        <Button Grid.Column="4" Content="Chiudi" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CloseCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>
