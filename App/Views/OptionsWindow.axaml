<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Navifox.App.ViewModels"
        x:Class="Navifox.App.Views.OptionsWindow"
        x:DataType="vm:OptionsViewModel"
        Title="Opzioni" Width="540" SizeToContent="Height" MaxHeight="780" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
    <StackPanel Margin="18" Spacing="12">
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="ASPETTO" Classes="field-label" />
          <Grid ColumnDefinitions="160,*"><TextBlock Text="Tema" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" HorizontalAlignment="Stretch" /></Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="DATI E QUERY" Classes="field-label" />
          <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="8">
            <CheckBox Classes="crit-check" Content="Limita i record" IsChecked="{Binding LimitRecords, Mode=TwoWay}" />
            <NumericUpDown Grid.Column="1" Value="{Binding PageSize, Mode=TwoWay}" Minimum="1" Maximum="1000000" FormatString="0" IsEnabled="{Binding LimitRecords}" ShowButtonSpinner="False" />
            <TextBlock Grid.Column="2" Text="record per pagina" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
          </Grid>
          <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="8">
            <TextBlock Text="Righe massime query" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding QueryMaxRows, Mode=TwoWay}" Minimum="1" Maximum="1000000" FormatString="0" ShowButtonSpinner="False" />
            <TextBlock Grid.Column="2" Text="righe" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
          </Grid>
          <TextBlock Text="Il Registro attività conserva automaticamente query e trasferimenti." TextWrapping="Wrap" />
          <CheckBox Classes="crit-check" Content="All'avvio riapri le schede dell'ultima sessione" IsChecked="{Binding RestoreSession, Mode=TwoWay}" />
          <CheckBox Classes="crit-check" Content="Modalità sicura: conferma UPDATE/DELETE senza WHERE, DROP e TRUNCATE" IsChecked="{Binding SafeMode, Mode=TwoWay}"
                    ToolTip.Tip="Sulle connessioni di produzione Navifox chiede sempre conferma prima di ogni modifica" />
          <Grid ColumnDefinitions="200,*">
            <TextBlock Text="Anteprima righe modificate" VerticalAlignment="Center"
                       ToolTip.Tip="Prima di un UPDATE o DELETE dall'editor SQL Navifox conta le righe che verranno toccate (SELECT COUNT(*) con lo stesso WHERE)" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding RowPreviewModes}" SelectedItem="{Binding RowPreview, Mode=TwoWay}" HorizontalAlignment="Stretch" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="SERVER MONITOR" Classes="field-label" />
          <Grid ColumnDefinitions="160,*"><TextBlock Text="Aggiornamento" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding Intervals}" SelectedItem="{Binding MonitorInterval, Mode=TwoWay}" HorizontalAlignment="Stretch" /></Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="ASSISTENTE SQL" Classes="field-label" />
          <Grid ColumnDefinitions="160,*"><TextBlock Text="Fornitore" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding AssistantProviders}" SelectedItem="{Binding AssistantProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" /></Grid>
          <Grid ColumnDefinitions="160,*" IsVisible="{Binding AssistantShowsUrl}"><TextBlock Text="Indirizzo API" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding AssistantBaseUrl, Mode=TwoWay}" Watermark="https://…/v1" /></Grid>
          <Grid ColumnDefinitions="160,*" IsVisible="{Binding AssistantShowsKey}"><TextBlock Text="Chiave API" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding AssistantKey, Mode=TwoWay}" PasswordChar="•" Watermark="{Binding AssistantKeyWatermark}" /></Grid>
          <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="6">
            <TextBlock Text="Modello" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding AssistantModelList}" Text="{Binding AssistantModel, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="Scrivi o carica l'elenco" />
            <Button Grid.Column="2" Classes="small-muted" Content="Carica modelli" Command="{Binding LoadAssistantModelsCommand}" IsEnabled="{Binding !AssistantBusy}" />
          </Grid>
          <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="6">
            <TextBlock Grid.Column="1" Text="{Binding AssistantStatus}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="small-muted" Content="Prova" Command="{Binding TestAssistantCommand}" IsEnabled="{Binding !AssistantBusy}" ToolTip.Tip="Invia una breve domanda di prova" />
          </Grid>
          <TextBlock Text="{Binding AssistantPrivacy}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="160,-4,0,0" />
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="AGGIORNAMENTI" Classes="field-label" />
          <CheckBox Classes="crit-check" Content="Controlla gli aggiornamenti all'avvio" IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}" />
          <Grid ColumnDefinitions="160,*"><TextBlock Text="Sorgente" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding UpdateSource, Mode=TwoWay}" Watermark="Cartella, \\server\condivisione, URL o GitHub" /></Grid>
          <TextBlock Text="{Binding DefaultUpdateSource}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="160,-4,0,0" />
          <TextBlock Text="{Binding CurrentVersion}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Annulla" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Content="Salva" Classes="dialog-primary" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding SaveCommand}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
