<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Navifox.App.ViewModels"
             xmlns:c="using:Navifox.App.Controls"
             xmlns:m="using:Navifox.Core.Models"
             x:Class="Navifox.App.Views.QueryPageView"
             x:DataType="vm:QueryTabViewModel">
  <Grid>
    <!-- ───── Editor query ───── -->
    <Grid IsVisible="{Binding IsEditor}" RowDefinitions="Auto,*,5,*,Auto">
      <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,3">
        <StackPanel Spacing="3">
          <WrapPanel>
            <Button Classes="objbar" Command="{Binding SaveCommand}" ToolTip.Tip="Salva (Ctrl+S)">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="download" Classes="objbar-icon" /><TextBlock Text="Salva" /></StackPanel>
            </Button>
            <Button Classes="objbar" Padding="3,4" Margin="-2,0,0,0">
              <c:NfIcon Kind="chevron-down" Width="12" Height="12" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="Salva con nome…" Command="{Binding SaveAsCommand}" />
                  <MenuItem Header="Salva in Query salvate" Command="{Binding SaveToLibraryCommand}" InputGesture="Ctrl+Shift+S" />
                  <MenuItem Header="Apri file SQL…" Command="{Binding OpenFileCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Border Classes="toolbar-sep" />
            <Button Classes="objbar" Command="{Binding QueryBuilderCommand}" ToolTip.Tip="Componi una SELECT in modo visuale">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="network" Classes="objbar-icon" /><TextBlock Text="Query Builder" /></StackPanel>
            </Button>
            <Button Classes="objbar" Command="{Binding BeautifyCommand}" ToolTip.Tip="Formatta SQL (Ctrl+Maiusc+F)">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="sliders" Classes="objbar-icon" /><TextBlock Text="Formatta SQL" /></StackPanel>
            </Button>
            <Button x:Name="SnippetButton" Classes="objbar" ToolTip.Tip="Inserisci un modello di codice">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="code" Classes="objbar-icon" /><TextBlock Text="Snippet" /><c:NfIcon Kind="chevron-down" Width="11" Height="11" /></StackPanel>
            </Button>
            <Border Classes="toolbar-sep" />
            <Button x:Name="AssistantButton" Classes="objbar" ToolTip.Tip="Assistente SQL (Claude, OpenAI, Gemini, modelli locali…): spiega, genera, ottimizza e corregge le query">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="star" Classes="objbar-icon" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="Assistente" /><c:NfIcon Kind="chevron-down" Width="11" Height="11" /></StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem x:Name="AssistExplainItem" Header="Spiega la query" />
                  <MenuItem Header="Genera SQL da una descrizione…" Command="{Binding AssistGenerateCommand}" />
                  <MenuItem x:Name="AssistOptimizeItem" Header="Ottimizza e suggerisci indici" />
                  <MenuItem Header="Correggi l'ultimo errore" Command="{Binding AssistFixCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </WrapPanel>
          <Grid ColumnDefinitions="300,200,Auto" ColumnSpacing="6" VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="30" MinHeight="30" Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5">
              <!-- Nella casella chiusa una sola riga (badge · nome · dialetto/host), alta come la casella del database. -->
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="m:ConnectionProfile">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <c:DialectBadge Profile="{Binding .}" Size="18" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ., Converter={x:Static c:DialectVisuals.SummaryConverter}}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:ConnectionProfile">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <c:DialectBadge Profile="{Binding .}" Size="22" />
                  <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ., Converter={x:Static c:DialectVisuals.SummaryConverter}}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                  </StackPanel>
                </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="30" MinHeight="30" Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5" PlaceholderText="(nessun database)">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="database" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding .}" /></StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
              <Button x:Name="RunButton" Classes="objbar" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Esegui (Ctrl+Invio o F5) · con una selezione esegue solo quella">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="play" Classes="objbar-icon run" /><TextBlock Text="Esegui" FontWeight="SemiBold" /></StackPanel>
              </Button>
              <Button Classes="objbar" Padding="3,4" Margin="-2,0,0,0" IsEnabled="{Binding !IsBusy}">
                <c:NfIcon Kind="chevron-down" Width="12" Height="12" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Esegui tutto" Command="{Binding ExecuteAllCommand}" InputGesture="Ctrl+R" />
                    <MenuItem x:Name="RunSelectionItem" Header="Esegui selezione" InputGesture="Ctrl+Enter" />
                    <MenuItem x:Name="RunCurrentItem" Header="Esegui istruzione corrente" InputGesture="Ctrl+Shift+Enter" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Classes="objbar" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="stop" Classes="objbar-icon" /><TextBlock Text="Interrompi" /></StackPanel>
              </Button>
              <Button x:Name="ExplainButton" Classes="objbar" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Piano di esecuzione dell’istruzione corrente">
                <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="layers" Classes="objbar-icon" /><TextBlock Text="Explain" /></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <c:SqlEditor x:Name="SqlEditor" Grid.Row="1" Padding="6,8" />
      <GridSplitter Grid.Row="2" Background="{DynamicResource BorderBrush}" ResizeDirection="Rows" />
      <TabControl Grid.Row="3" SelectedIndex="{Binding ResultTabIndex, Mode=TwoWay}" Classes="workspace" Padding="0">
        <TabItem Header="Risultato">
          <DataGrid x:Name="ResultGrid" Classes="nf-grid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="False" />
        </TabItem>
        <TabItem Header="Grafico">
          <Grid RowDefinitions="Auto,*,Auto">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
              <WrapPanel>
                <TextBlock Text="Tipo" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                <ComboBox ItemsSource="{Binding ChartKinds}" SelectedItem="{Binding ChartKind, Mode=TwoWay}" MinWidth="100" Margin="0,0,14,0" FontSize="12" />
                <TextBlock Text="Etichette" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                <ComboBox ItemsSource="{Binding ChartLabelColumns}" SelectedItem="{Binding ChartLabelColumn, Mode=TwoWay}" MinWidth="140" Margin="0,0,14,0" FontSize="12" />
                <TextBlock Text="Valori" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                <ComboBox ItemsSource="{Binding ChartValueColumns}" SelectedItem="{Binding ChartValueColumn, Mode=TwoWay}" MinWidth="140" FontSize="12" />
              </WrapPanel>
            </Border>
            <c:ChartCanvas Grid.Row="1" Points="{Binding ChartPoints}" Kind="{Binding ChartKind}" Margin="10,12" />
            <TextBlock Grid.Row="2" Text="{Binding ChartInfo}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,0,10,6" />
          </Grid>
        </TabItem>
        <TabItem Header="Messaggi">
          <ListBox ItemsSource="{Binding Messages}" Background="Transparent" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String"><SelectableTextBlock Text="{Binding .}" TextWrapping="Wrap" /></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Assistente">
          <Grid RowDefinitions="Auto,*">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                  <Button Classes="objbar" Command="{Binding InsertAssistantSqlCommand}" IsVisible="{Binding HasAssistantSql}" ToolTip.Tip="Inserisci l'SQL proposto al cursore">
                    <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="plus" Classes="objbar-icon" /><TextBlock Text="Inserisci SQL" /></StackPanel>
                  </Button>
                  <Button Classes="objbar" Command="{Binding ReplaceWithAssistantSqlCommand}" IsVisible="{Binding HasAssistantSql}" ToolTip.Tip="Sostituisci il testo dell'editor con l'SQL proposto">
                    <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="file-code" Classes="objbar-icon" /><TextBlock Text="Sostituisci" /></StackPanel>
                  </Button>
                  <Button Classes="objbar" Command="{Binding CopyAssistantCommand}" ToolTip.Tip="Copia la risposta">
                    <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="copy" Classes="objbar-icon" /><TextBlock Text="Copia" /></StackPanel>
                  </Button>
                  <Button Classes="objbar" Command="{Binding StopAssistantCommand}" IsVisible="{Binding AssistantBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="stop" Classes="objbar-icon" /><TextBlock Text="Interrompi" /></StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                  <c:NfIcon Kind="star" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding AssistantTitle}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                  <ProgressBar IsIndeterminate="True" Width="70" Height="3" MinWidth="0" IsVisible="{Binding AssistantBusy}" VerticalAlignment="Center" />
                </StackPanel>
              </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Padding="14,10">
              <Grid>
                <SelectableTextBlock Text="{Binding AssistantText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" />
                <StackPanel Spacing="10" MaxWidth="560" HorizontalAlignment="Left" IsVisible="{Binding !AssistantText.Length}">
                  <TextBlock Text="Assistente SQL" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5"
                             Text="Claude conosce la struttura del database collegato: chiedigli di spiegare una query, di scriverla partendo da una frase in italiano, di suggerire indici partendo dal piano di esecuzione o di correggere l'ultimo errore. Usa il pulsante «Assistente» nella barra in alto." />
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
        </TabItem>
      </TabControl>
      <Border Grid.Row="4" Classes="grid-statusbar">
        <DockPanel>
          <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100" Height="3" MinWidth="0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </Grid>

    <!-- ───── Console ───── -->
    <Grid IsVisible="{Binding IsConsole}" RowDefinitions="*,Auto" Background="#16181C">
      <TextBox x:Name="ConsoleOutput" Text="{Binding ConsoleText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13" Foreground="#E9E7E4" Background="Transparent"
               BorderThickness="0" CornerRadius="0" Padding="12,10" CaretBrush="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
      <Border Grid.Row="1" BorderBrush="#2A2F36" BorderThickness="0,1,0,0" Padding="12,6">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding Prompt}" Foreground="#FF7A2F" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13" VerticalAlignment="Center" />
          <TextBox x:Name="ConsoleInputBox" Grid.Column="1" Text="{Binding ConsoleInput, Mode=TwoWay}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13"
                   Foreground="#E9E7E4" Background="Transparent" BorderThickness="0" CaretBrush="#FF7A2F" Padding="0,4" />
          <ProgressBar Grid.Column="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="60" Height="3" MinWidth="0" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
