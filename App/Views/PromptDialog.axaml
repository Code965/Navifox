<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Navifox.App.Views.PromptDialog"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
  <Grid RowDefinitions="*,Auto">
    <StackPanel Margin="22,20,22,16" Spacing="10">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
      <TextBlock x:Name="MessageText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
      <TextBox x:Name="InputBox" />
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,11">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelButton" Content="Annulla" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
        <Button x:Name="ConfirmButton" Content="OK" Classes="dialog-primary" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
