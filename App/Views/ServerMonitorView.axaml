<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Navifox.App.ViewModels"
             xmlns:c="using:Navifox.App.Controls"
             x:Class="Navifox.App.Views.ServerMonitorView"
             x:DataType="vm:ServerMonitorViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- toolbar -->
    <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
      <Grid ColumnDefinitions="*,Auto">
        <WrapPanel Orientation="Horizontal">
          <Button Classes="objbar" Command="{Binding RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="refresh" Classes="objbar-icon" /><TextBlock Text="Aggiorna" /></StackPanel>
          </Button>
          <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval, Mode=TwoWay}" MinHeight="26" FontSize="12" Margin="2,0" ToolTip.Tip="Aggiornamento automatico" />
          <Border Classes="toolbar-sep" />
          <Button Classes="objbar" Command="{Binding CancelQueryCommand}" ToolTip.Tip="Interrompe solo la query in esecuzione">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="stop" Classes="objbar-icon" /><TextBlock Text="Interrompi query" /></StackPanel>
          </Button>
          <Button Classes="objbar" Command="{Binding EndProcessCommand}" ToolTip.Tip="Termina la sessione">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="x" Classes="objbar-icon" /><TextBlock Text="Termina processo" /></StackPanel>
          </Button>
          <Button Classes="objbar" Command="{Binding CopyQueryCommand}" ToolTip.Tip="Copia la query del processo">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="copy" Classes="objbar-icon" /><TextBlock Text="Copia query" /></StackPanel>
          </Button>
          <Border Classes="toolbar-sep" />
          <ToggleButton Classes="objbar" IsChecked="{Binding HideIdle, Mode=TwoWay}" ToolTip.Tip="Nascondi le sessioni inattive (Sleep / idle)">
            <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="filter" Classes="objbar-icon" /><TextBlock Text="Solo attivi" /></StackPanel>
          </ToggleButton>
        </WrapPanel>
        <Grid Grid.Column="1" Width="220" VerticalAlignment="Center">
          <TextBox Text="{Binding FilterText, Mode=TwoWay}" Watermark="Filtra…" Padding="28,4,8,4" MinHeight="26" FontSize="12" />
          <c:NfIcon Kind="search" Width="13" Height="13" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
        </Grid>
      </Grid>
    </Border>

    <!-- elenco dei server a sinistra + processi/variabili/stato -->
    <Grid Grid.Row="1" Grid.RowSpan="2" ColumnDefinitions="250,1,*">
      <Border Background="{DynamicResource InsetBrush}">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Servers}" Margin="6">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MonitorServer">
                <Border Classes="monitor-server" Classes.off="{Binding !IsChecked}">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8" RowSpacing="2">
                    <CheckBox Classes="crit-check" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <c:DialectBadge Profile="{Binding Profile}" Size="18" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                      <Ellipse Width="7" Height="7" Fill="#45A989" IsVisible="{Binding !HasError}" VerticalAlignment="Center" ToolTip.Tip="Raggiungibile" />
                      <Ellipse Width="7" Height="7" Fill="#C0392B" IsVisible="{Binding HasError}" VerticalAlignment="Center" ToolTip.Tip="Non raggiungibile" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Version}" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding !HasError}" Margin="0,4,0,0">
                      <TextBlock FontSize="11.5" VerticalAlignment="Center">
                        <Run Text="{Binding Connections}" FontWeight="SemiBold" /><Run Text=" conn." Foreground="{DynamicResource MutedTextBrush}" />
                      </TextBlock>
                      <ProgressBar Grid.Column="1" Value="{Binding ConnectionUsage}" Maximum="100" Height="4" MinWidth="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" CornerRadius="2" />
                    </Grid>
                    <WrapPanel Grid.Row="3" Grid.Column="1" IsVisible="{Binding !HasError}" Margin="0,2,0,0">
                      <TextBlock Classes="mon-chip" ToolTip.Tip="Uptime"><Run Text="⏱ " /><Run Text="{Binding Uptime}" /></TextBlock>
                      <TextBlock Classes="mon-chip" ToolTip.Tip="Query al secondo"><Run Text="{Binding QueriesPerSecond}" FontWeight="SemiBold" /><Run Text=" q/s" /></TextBlock>
                      <TextBlock Classes="mon-chip" ToolTip.Tip="Processi attivi"><Run Text="{Binding Running}" FontWeight="SemiBold" /><Run Text=" attivi" /></TextBlock>
                      <TextBlock Classes="mon-chip" ToolTip.Tip="Query lente"><Run Text="{Binding SlowQueries}" FontWeight="SemiBold" /><Run Text=" lente" /></TextBlock>
                      <TextBlock Classes="mon-chip" ToolTip.Tip="Traffico ricevuto / inviato" Text="{Binding Traffic}" />
                    </WrapPanel>
                    <Grid Grid.Row="4" Grid.Column="1" RowDefinitions="Auto,Auto" Margin="0,6,0,0" IsVisible="{Binding !HasError}">
                      <c:ChartCanvas Height="30" Points="{Binding QpsHistory}" Kind="Area" Compact="True" />
                      <TextBlock Grid.Row="1" Text="{Binding QpsPeak}" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#B42318" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
    <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Classes="workspace" Padding="0" Margin="0">
      <TabItem Header="Processi">
        <DataGrid x:Name="ProcessGrid" Classes="nf-grid" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="True" CanUserResizeColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="170" x:DataType="vm:ProcessRow" />
            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70" x:DataType="vm:ProcessRow" />
            <DataGridTextColumn Header="Utente" Binding="{Binding User}" Width="110" x:DataType="vm:ProcessRow" />
            <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="140" x:DataType="vm:ProcessRow" />
            <DataGridTextColumn Header="Database" Binding="{Binding Db}" Width="110" x:DataType="vm:ProcessRow" />
            <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="100" x:DataType="vm:ProcessRow" />
            <DataGridTemplateColumn Header="Tempo" Width="80" SortMemberPath="Time">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ProcessRow">
                  <TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0" Classes.long="{Binding IsLong}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="150" x:DataType="vm:ProcessRow" />
            <DataGridTemplateColumn Header="Query" Width="520" SortMemberPath="Info">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ProcessRow">
                  <TextBlock Text="{Binding InfoShort}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" VerticalAlignment="Center" Margin="6,0"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Info}" Classes.long="{Binding IsLong}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Variabili">
        <DataGrid Classes="nf-grid" ItemsSource="{Binding Variables}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="120" x:DataType="vm:ServerSetting" />
            <DataGridTextColumn Header="Variabile" Binding="{Binding Name}" Width="320" x:DataType="vm:ServerSetting" />
            <DataGridTextColumn Header="Valore" Binding="{Binding Value}" Width="*" x:DataType="vm:ServerSetting" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Stato" x:Name="StatusTab">
        <DataGrid Classes="nf-grid" ItemsSource="{Binding Status}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="120" x:DataType="vm:ServerSetting" />
            <DataGridTextColumn Header="Indicatore" Binding="{Binding Name}" Width="320" x:DataType="vm:ServerSetting" />
            <DataGridTextColumn Header="Valore" Binding="{Binding Value}" Width="*" x:DataType="vm:ServerSetting" />
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Query lente">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="{Binding SlowQueryInfo}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="10,6" TextWrapping="Wrap" />
          <DataGrid Grid.Row="1" Classes="nf-grid" ItemsSource="{Binding SlowQueries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="140" x:DataType="vm:SlowQueryRow" />
              <DataGridTextColumn Header="Database" Binding="{Binding Database}" Width="110" x:DataType="vm:SlowQueryRow" />
              <DataGridTextColumn Header="Media" Binding="{Binding AverageLabel}" Width="90" SortMemberPath="AverageMs" x:DataType="vm:SlowQueryRow" />
              <DataGridTextColumn Header="Max" Binding="{Binding MaxLabel}" Width="90" SortMemberPath="MaxMs" x:DataType="vm:SlowQueryRow" />
              <DataGridTextColumn Header="Esecuzioni" Binding="{Binding Calls}" Width="90" x:DataType="vm:SlowQueryRow" />
              <DataGridTextColumn Header="Tempo totale" Binding="{Binding TotalLabel}" Width="100" SortMemberPath="TotalMs" x:DataType="vm:SlowQueryRow" />
              <DataGridTextColumn Header="Righe" Binding="{Binding Rows}" Width="80" x:DataType="vm:SlowQueryRow" />
              <DataGridTemplateColumn Header="Query" Width="600">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:SlowQueryRow">
                    <TextBlock Text="{Binding QueryShort}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Query}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
    </Grid>

    <Border Grid.Row="3" Classes="grid-statusbar">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="80" Height="3" MinWidth="0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
