<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Navifox.App.ViewModels"
        x:Class="Navifox.App.Views.DatabaseDialog"
        x:DataType="vm:DatabaseDialogViewModel"
        Title="{Binding Title}" Width="520" Height="420" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="*,Auto">
    <TabControl Margin="12,8,12,0" Padding="0,8,0,0">
      <TabItem Header="Generale">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
          <StackPanel Spacing="12">
            <StackPanel Spacing="5">
              <TextBlock Text="Nome database" Classes="field-label" />
              <TextBox x:Name="NameBox" Text="{Binding Name, Mode=TwoWay}" IsReadOnly="{Binding !CanEditName}" Watermark="nuovo_database" />
            </StackPanel>
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding CharsetLabel}" Classes="field-label" />
              <ComboBox ItemsSource="{Binding Charsets}" SelectedItem="{Binding SelectedCharset, Mode=TwoWay}" IsEnabled="{Binding CanEditCharset}" HorizontalAlignment="Stretch" PlaceholderText="(predefinito del server)" />
            </StackPanel>
            <StackPanel Spacing="5" IsVisible="{Binding ShowCollation}">
              <TextBlock Text="Collation" Classes="field-label" />
              <ComboBox ItemsSource="{Binding Collations}" SelectedItem="{Binding SelectedCollation, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="(predefinita del set di caratteri)" />
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Header="Anteprima SQL">
        <TextBox Text="{Binding SqlPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13" />
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,11" Margin="0,10,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Annulla" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Grid.Column="2" Content="Salva" Classes="dialog-primary" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding ConfirmCommand}" IsDefault="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
