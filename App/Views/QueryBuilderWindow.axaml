<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MosaicDB.App.ViewModels"
        xmlns:c="using:MosaicDB.App.Controls"
        x:Class="MosaicDB.App.Views.QueryBuilderWindow"
        x:DataType="vm:QueryBuilderViewModel"
        Title="Query Builder" Width="1040" Height="680" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="*,Auto,Auto">
    <Grid ColumnDefinitions="220,*,300" ColumnSpacing="10" Margin="12">
      <!-- tabelle -->
      <Border Classes="card">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Text="TABELLA PRINCIPALE" Classes="field-label" Margin="10,8,10,4" />
          <TextBox Grid.Row="1" Text="{Binding TableFilter, Mode=TwoWay}" Watermark="Filtra…" Margin="8,0,8,6" MinHeight="26" FontSize="12" />
          <ListBox Grid.Row="2" ItemsSource="{Binding FilteredTables}" SelectedItem="{Binding MainTable, Mode=TwoWay}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="table" Width="13" Height="13" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding .}" /></StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <!-- colonne -->
      <Border Grid.Column="1" Classes="card">
        <Grid RowDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,6">
            <TextBlock Text="COLONNE" Classes="field-label" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Classes="objbar" Content="Tutte" Command="{Binding SelectAllCommand}" CommandParameter="all" />
            <Button Classes="objbar" Content="Nessuna" Command="{Binding SelectAllCommand}" CommandParameter="none" />
            <TextBlock Text="(nessuna selezionata = *)" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <ListBox Grid.Row="1" ItemsSource="{Binding Columns}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:BuilderColumn">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="7">
                  <CheckBox Classes="crit-check" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  <c:NfIcon Grid.Column="1" Kind="{Binding Icon}" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Table}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <!-- join e opzioni -->
      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="10">
          <Border Classes="card" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="JOIN (DALLE CHIAVI ESTERNE)" Classes="field-label" />
              <TextBlock Text="Nessuna relazione per questa tabella." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" IsVisible="{Binding !Joins.Count}" />
              <ItemsControl ItemsSource="{Binding Joins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuilderJoin">
                    <StackPanel Spacing="3" Margin="0,0,0,8">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <CheckBox Classes="crit-check" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        <c:NfIcon Kind="link" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Table}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,0,0,0" />
                      <ComboBox ItemsSource="{Binding JoinTypes}" SelectedItem="{Binding JoinType, Mode=TwoWay}" Margin="24,0,0,0" MinHeight="24" FontSize="12" IsEnabled="{Binding IsSelected}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="10">
            <StackPanel Spacing="8">
              <TextBlock Text="FILTRO E ORDINAMENTO" Classes="field-label" />
              <CheckBox Classes="crit-check" Content="DISTINCT" IsChecked="{Binding Distinct, Mode=TwoWay}" />
              <TextBlock Text="WHERE" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBox Text="{Binding Where, Mode=TwoWay}" Watermark="t0.colonna = 'valore'" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" AcceptsReturn="True" Height="54" TextWrapping="Wrap" />
              <TextBlock Text="ORDER BY" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
              <Grid ColumnDefinitions="*,80" ColumnSpacing="6">
                <ComboBox ItemsSource="{Binding OrderColumns}" SelectedItem="{Binding OrderBy, Mode=TwoWay}" HorizontalAlignment="Stretch" PlaceholderText="(nessuno)" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="LIMIT" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Limit, Mode=TwoWay}" Minimum="0" Maximum="1000000" FormatString="0" Width="120" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="1" Classes="card" Margin="12,0,12,10" Height="130">
      <SelectableTextBlock Text="{Binding GeneratedSql}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12.5" Margin="10" TextWrapping="Wrap" />
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Annulla" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Content="Inserisci nella query" Classes="dialog-primary" MinWidth="140" HorizontalContentAlignment="Center" Command="{Binding ConfirmCommand}" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
