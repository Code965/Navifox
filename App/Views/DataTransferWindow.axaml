<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Navifox.App.ViewModels"
        xmlns:m="using:Navifox.Core.Models"
        xmlns:c="using:Navifox.App.Controls"
        x:Class="Navifox.App.Views.DataTransferWindow"
        x:DataType="vm:DataTransferViewModel"
        Title="Trasferimento dati" Width="1000" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}">
  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.step-dot">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
    </Style>
    <Style Selector="Border.step-dot.on">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.step-dot TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.step-dot.on TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.obj-expander">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="ToggleButton.obj-expander:checked">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="ToggleButton.obj-expander:checked /template/ ContentPresenter, ToggleButton.obj-expander:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector=":is(Panel).obj-node">
      <Setter Property="MinHeight" Value="24" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- testata: origine → destinazione + passi -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="step-dot" Classes.on="{Binding IsStep1}"><TextBlock Text="1" /></Border>
          <Border Classes="step-dot" Classes.on="{Binding IsStep2}"><TextBlock Text="2" /></Border>
          <Border Classes="step-dot" Classes.on="{Binding IsStep3}"><TextBlock Text="3" /></Border>
          <Border Classes="step-dot" Classes.on="{Binding IsStep4}"><TextBlock Text="4" /></Border>
          <TextBlock Text="{Binding StepTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding SourceTitle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding SourceSubtitle}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" />
          </StackPanel>
          <c:DialectBadge Profile="{Binding SourceProfile}" Size="30" />
          <c:NfIcon Kind="chevron-right" Width="20" Height="20" StrokeWidth="2.6" Foreground="{DynamicResource AccentBrush}" />
          <Grid>
            <c:DialectBadge Profile="{Binding TargetProfile}" Size="30" IsVisible="{Binding TargetIsConnection}" />
            <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding TargetIsFile}">
              <c:NfIcon Kind="file-code" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
            </Border>
          </Grid>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding TargetTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding TargetSubtitle}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <!-- ═══ PASSO 1: origine e destinazione ═══ -->
      <Grid IsVisible="{Binding IsStep1}" ColumnDefinitions="*,Auto,*" Margin="34,26,34,10">
        <StackPanel Spacing="8">
          <TextBlock Text="Origine" Classes="section" />
          <TextBlock Text="Connessione" Classes="field-label" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SourceProfile, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="44">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="m:ConnectionProfile">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                <c:DialectBadge Profile="{Binding .}" Size="22" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ., Converter={x:Static c:DialectVisuals.SummaryConverter}}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Database" Classes="field-label" Margin="0,6,0,0" />
          <ComboBox ItemsSource="{Binding SourceDatabases}" SelectedItem="{Binding SourceDatabase, Mode=TwoWay}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="x:String">
              <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="database" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding .}" /></StackPanel>
            </DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Informazioni" Classes="section" Margin="0,26,0,4" />
          <ItemsControl ItemsSource="{Binding SourceInfo}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PropertyItem">
              <Grid ColumnDefinitions="160,*" Margin="0,2"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource SecondaryTextBrush}" /><SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="28,62,28,0" VerticalAlignment="Top" Spacing="8">
          <Button Classes="tb-icon" Command="{Binding SwapCommand}" IsEnabled="{Binding TargetIsConnection}" ToolTip.Tip="Scambia origine e destinazione" Width="36" Height="34">
            <c:NfIcon Kind="transfer" Width="18" Height="18" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="8">
          <TextBlock Text="Destinazione" Classes="section" />
          <StackPanel Orientation="Horizontal" Spacing="22">
            <RadioButton GroupName="target" Content="Connessione" IsChecked="{Binding TargetIsConnection, Mode=TwoWay}" />
            <RadioButton GroupName="target" Content="File SQL" IsChecked="{Binding TargetIsFile, Mode=TwoWay}" />
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding TargetIsConnection}">
            <ComboBox ItemsSource="{Binding TargetProfiles}" SelectedItem="{Binding TargetProfile, Mode=TwoWay}" HorizontalAlignment="Stretch" MinHeight="44">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="m:ConnectionProfile">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                  <c:DialectBadge Profile="{Binding .}" Size="22" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ., Converter={x:Static c:DialectVisuals.SummaryConverter}}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                  </StackPanel>
                </Grid>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Solo connessioni dello stesso tipo dell’origine." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="Database" Classes="field-label" />
            <ComboBox ItemsSource="{Binding TargetDatabases}" SelectedItem="{Binding TargetDatabase, Mode=TwoWay}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="7"><c:NfIcon Kind="database" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding .}" /></StackPanel>
              </DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding TargetIsFile}">
            <TextBlock Text="File di destinazione" Classes="field-label" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding TargetFile, Mode=TwoWay}" Watermark="C:\…\export.sql" />
              <Button Grid.Column="1" Content="Sfoglia…" Classes="small-muted" Command="{Binding BrowseFileCommand}" />
            </Grid>
            <TextBlock Text="Viene creato uno script SQL con struttura e/o dati delle tabelle scelte." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="Informazioni" Classes="section" Margin="0,26,0,4" IsVisible="{Binding TargetIsConnection}" />
          <ItemsControl ItemsSource="{Binding TargetInfo}" IsVisible="{Binding TargetIsConnection}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PropertyItem">
              <Grid ColumnDefinitions="160,*" Margin="0,2"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource SecondaryTextBrush}" /><SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" /></Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>

      <!-- ═══ PASSO 2: oggetti del database ═══ -->
      <Grid IsVisible="{Binding IsStep2}" ColumnDefinitions="*,Auto,320" Margin="16,12,16,10">
        <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,10,0">
          <TextBlock Text="Oggetti del database" Classes="section" />
          <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,240" ColumnSpacing="4" Margin="0,0,0,6">
            <Button Classes="objbar" Content="Tutte" Command="{Binding SelectAllCommand}" CommandParameter="all" IsEnabled="{Binding CanPickTables}" ToolTip.Tip="Seleziona le tabelle visibili" />
            <Button Grid.Column="1" Classes="objbar" Content="Nessuna" Command="{Binding SelectAllCommand}" CommandParameter="none" IsEnabled="{Binding CanPickTables}" ToolTip.Tip="Deseleziona le tabelle visibili" />
            <TextBlock Grid.Column="2" Text="{Binding SelectionLabel}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0" />
            <Grid Grid.Column="3">
              <TextBox Text="{Binding TableFilter, Mode=TwoWay}" Watermark="Filtra tabelle…" Padding="28,4,8,4" MinHeight="26" FontSize="12" />
              <c:NfIcon Kind="search" Width="13" Height="13" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
            </Grid>
          </Grid>
          <Border Grid.Row="2" Classes="card" Padding="6,6">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="1">
                <!-- Tabelle (n/N) -->
                <StackPanel Orientation="Horizontal" Spacing="6" Classes="obj-node">
                  <ToggleButton Classes="obj-expander" IsChecked="{Binding TablesExpanded, Mode=TwoWay}"><c:NfIcon Kind="chevron-down" Width="12" Height="12" StrokeWidth="2.6" /></ToggleButton>
                  <c:NfIcon Kind="table" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding TablesHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{Binding TablesExpanded}" Margin="22,0,0,0" Spacing="1">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,0,0,0" Classes="obj-node">
                    <CheckBox Classes="crit-check" IsChecked="{Binding AllTablesAtRun, Mode=TwoWay}" VerticalAlignment="Center" />
                    <c:NfIcon Kind="table" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="Tutte le tabelle al momento dell’esecuzione ( * )" VerticalAlignment="Center"
                               ToolTip.Tip="All’avvio si rilegge l’elenco: vengono trasferite tutte le tabelle presenti in quel momento, anche quelle create dopo" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" Classes="obj-node" IsEnabled="{Binding CanPickTables}">
                    <ToggleButton Classes="obj-expander" IsChecked="{Binding CustomExpanded, Mode=TwoWay}"><c:NfIcon Kind="chevron-down" Width="12" Height="12" StrokeWidth="2.6" /></ToggleButton>
                    <CheckBox Classes="crit-check" IsThreeState="True" IsChecked="{Binding CustomSelection, Mode=TwoWay}" VerticalAlignment="Center" />
                    <c:NfIcon Kind="table" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding CustomHeader}" VerticalAlignment="Center" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding VisibleBaseTables}" IsVisible="{Binding CustomExpanded}" IsEnabled="{Binding CanPickTables}" Margin="42,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TransferTable">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" Classes="obj-node">
                          <CheckBox Classes="crit-check" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                          <c:NfIcon Grid.Column="1" Kind="{Binding Glyph}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                          <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Classes="no-tr" />
                          <TextBlock Grid.Column="3" Text="{Binding State}" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <!-- Viste (0/N): non vengono trasferite -->
                <StackPanel Orientation="Horizontal" Spacing="6" Classes="obj-node" Margin="0,4,0,0">
                  <ToggleButton Classes="obj-expander" IsChecked="{Binding ViewsExpanded, Mode=TwoWay}"><c:NfIcon Kind="chevron-down" Width="12" Height="12" StrokeWidth="2.6" /></ToggleButton>
                  <c:NfIcon Kind="eye" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{Binding ViewsHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel IsVisible="{Binding ViewsExpanded}" Margin="42,0,0,0" Spacing="1">
                  <TextBlock Text="Le viste non vengono trasferite: ricreale dalla destinazione con il loro SQL." FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,2" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding VisibleViews}" IsEnabled="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TransferTable">
                        <StackPanel Orientation="Horizontal" Spacing="6" Classes="obj-node">
                          <CheckBox Classes="crit-check" IsChecked="False" VerticalAlignment="Center" />
                          <c:NfIcon Kind="eye" Width="14" Height="14" Foreground="{DynamicResource MutedTextBrush}" />
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Classes="no-tr" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,30,0,0" />
        <StackPanel Grid.Column="2" Spacing="10" Margin="16,30,0,0">
          <TextBlock Text="Seleziona gli oggetti da trasferire. Con «Tutte le tabelle al momento dell’esecuzione» l’elenco si rilegge all’avvio, comprese le tabelle create nel frattempo."
                     TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
          <Border Classes="card" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="OPZIONI" Classes="field-label" />
              <CheckBox Classes="crit-check" Content="Crea le tabelle (elimina se esistono)" IsChecked="{Binding CreateTables, Mode=TwoWay}" />
              <CheckBox Classes="crit-check" Content="Copia i dati" IsChecked="{Binding CopyData, Mode=TwoWay}" />
              <CheckBox Classes="crit-check" Content="Maschera i dati personali riconosciuti" IsChecked="{Binding AnonymizeData, Mode=TwoWay}" IsEnabled="{Binding CopyData}" />
              <TextBlock Text="Nomi, email, telefoni e altri campi riconosciuti vengono sostituiti. Chiavi, relazioni e campi non riconosciuti restano invariati: controlla l’elenco prima di copiare o distribuire i dati. Non garantisce l’anonimizzazione completa."
                         IsVisible="{Binding AnonymizeData}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
              <CheckBox Classes="crit-check" Content="Svuota le tabelle di destinazione" IsChecked="{Binding EmptyTarget, Mode=TwoWay}" IsEnabled="{Binding !CreateTables}" IsVisible="{Binding TargetIsConnection}" />
              <CheckBox Classes="crit-check" Content="Continua in caso di errore" IsChecked="{Binding ContinueOnError, Mode=TwoWay}" IsVisible="{Binding TargetIsConnection}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ═══ PASSO 3: riepilogo (oggetto di origine → destinazione, modalità) ═══ -->
      <Grid IsVisible="{Binding IsStep3}" RowDefinitions="Auto,Auto,*,Auto" Margin="28,18,28,10">
        <TextBlock Text="Riepilogo" Classes="section" />
        <TextBlock Grid.Row="1" Text="{Binding SummaryCount}" Margin="0,0,0,12" />
        <Border Grid.Row="2" Classes="card" HorizontalAlignment="Left" MinWidth="640" VerticalAlignment="Stretch">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="240,240,*" Margin="10,6">
              <TextBlock Text="Oggetto di origine" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Grid.Column="1" Text="Oggetto di destinazione" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
              <TextBlock Grid.Column="2" Text="Modalità" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" MinWidth="160" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding SummaryRows}" Margin="0,2">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TransferSummaryRow">
                      <Grid ColumnDefinitions="240,240,*" Margin="10,3">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <c:NfIcon Kind="{Binding Glyph}" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" />
                          <TextBlock Text="{Binding Source}" Classes="no-tr" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Target}" Classes="no-tr" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Mode}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="{Binding SummaryOptions}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
      </Grid>

      <!-- ═══ PASSO 4: avvio (avanzamento e registro) ═══ -->
      <Grid IsVisible="{Binding IsStep4}" RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="16,12,16,10">
        <Border Classes="card" Padding="14,10">
          <SelectableTextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12.5" />
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="5">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <ProgressBar Value="{Binding Progress}" Height="8" MinWidth="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource InsetBrush}" CornerRadius="4" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0}%}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" MinWidth="42" TextAlignment="Right" />
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
        </Grid>
        <Border Grid.Row="2" Classes="card">
          <Grid RowDefinitions="*,Auto">
            <ListBox x:Name="LogList" ItemsSource="{Binding Log}" Background="Transparent" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5">
              <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,1" /><Setter Property="MinHeight" Value="0" /></Style>
                <Style Selector="SelectableTextBlock.sql"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /></Style>
                <Style Selector="SelectableTextBlock.ok"><Setter Property="Foreground" Value="#2E7D4F" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
                <Style Selector="SelectableTextBlock.error"><Setter Property="Foreground" Value="#C0392B" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
                <Style Selector="SelectableTextBlock.info"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TransferLogEntry">
                  <Grid ColumnDefinitions="70,44,*">
                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Grid.Column="1" Text="SQL" IsVisible="{Binding IsSql}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <SelectableTextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"
                               Classes.sql="{Binding IsSql}" Classes.ok="{Binding IsOk}" Classes.error="{Binding IsError}" Classes.info="{Binding IsInfo}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="6,3">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="objbar" Click="OnCopyLog" ToolTip.Tip="Copia tutto il registro negli appunti">
                  <StackPanel Orientation="Horizontal" Spacing="6"><c:NfIcon Kind="copy" Classes="objbar-icon" /><TextBlock Text="Copia registro" /></StackPanel>
                </Button>
                <CheckBox x:Name="FollowLog" Classes="crit-check" Content="Segui gli ultimi comandi" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- piede -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Content="‹ Indietro" Classes="small-muted" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
        <Button Grid.Column="2" Content="Avanti ›" Classes="dialog-primary" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding NextCommand}" IsVisible="{Binding !IsLastStep}" />
        <Button Grid.Column="3" Content="Interrompi" Classes="small-muted" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" IsVisible="{Binding IsStep4}" />
        <Button Grid.Column="4" Content="Avvia" Classes="dialog-primary" MinWidth="90" HorizontalContentAlignment="Center" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" IsVisible="{Binding IsLastStep}" />
        <Button Grid.Column="5" Content="Chiudi" Classes="small-muted" MinWidth="80" HorizontalContentAlignment="Center" Command="{Binding CloseCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>
