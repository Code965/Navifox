<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:MosaicDB.App.Controls" xmlns:cc="using:AvaloniaEdit.CodeCompletion">
  <Style Selector="Button.toolbar, Button.toolbar-primary">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.toolbar:pointerover, Button.small-muted:pointerover, Button.icon-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="Button.toolbar-primary, Button.welcome-button, Button.accent, Button.small-accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.toolbar-primary:pointerover, Button.welcome-button:pointerover, Button.accent:pointerover, Button.small-accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.update-pill">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.update-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FF7A2F" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.small-muted">
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="11,7" />
  </Style>
  <Style Selector="Button.small-accent">
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <!-- Toolbar della scheda Oggetti -->
  <Style Selector="Button.objbar, ToggleButton.objbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.objbar:pointerover /template/ ContentPresenter, ToggleButton.objbar:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.objbar:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.objbar:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.objbar-glyph">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.objbar:disabled TextBlock.objbar-glyph">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <!-- Albero connessioni -->
  <Style Selector="Button.tree-tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tree-tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.tree-glyph">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.tree-glyph.open">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.tree-label">
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.tree-label.placeholder">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="FontStyle" Value="Italic" />
  </Style>

  <!-- Schede area di lavoro -->
  <Style Selector="TabControl.workspace">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabControl.workspace TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,0,6,0" />
  </Style>
  <Style Selector="Button.tab-close">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Pulsante primario dei dialoghi (sostituisce l'accento blu di Fluent) -->
  <Style Selector="Button.dialog-primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.dialog-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.dialog-primary.danger /template/ ContentPresenter">
    <Setter Property="Background" Value="#B42318" />
  </Style>
  <Style Selector="Button.dialog-primary.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#912018" />
  </Style>
  <Style Selector="Button.dialog-primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <!-- Griglia dati Navifox: densa, con linee, indicatore riga e colori palette -->
  <Style Selector="DataGrid.nf-grid">
    <Setter Property="GridLinesVisibility" Value="All" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HeadersVisibility" Value="All" />
    <Setter Property="RowHeight" Value="25" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="RowHeaderWidth" Value="20" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="MinColumnWidth" Value="40" />
    <Setter Property="ClipboardCopyMode" Value="ExcludeHeader" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridColumnHeader">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridRowHeader">
    <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
    <Setter Property="SeparatorBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="AreSeparatorsVisible" Value="True" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridRow:nth-child(2n)">
    <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridCell:current /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridCell:current">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridCell:current TextBlock.null-cell">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridCell">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TextBlock.null-cell">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Border.grid-statusbar">
    <Setter Property="Background" Value="{DynamicResource InsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="28" />
  </Style>
  <Style Selector="Border.grid-statusbar TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>

  <Style Selector="TextBlock.menu-glyph">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="MenuItem:disabled TextBlock.menu-glyph">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>

  <!-- Elenchi formato (Export/Import Wizard) -->
  <Style Selector="ListBox.format-list ListBoxItem">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.format-list ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ListBox.format-list ListBoxItem Ellipse.radio-dot">
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.format-list ListBoxItem:selected Ellipse.radio-dot">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Scheda tabella -->
  <Style Selector="Border.toolbar-sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="5,0" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleSplitButton.objbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
  </Style>
  <Style Selector="ToggleSplitButton.objbar:checked /template/ Button#PART_PrimaryButton, ToggleSplitButton.objbar:checked /template/ Button#PART_SecondaryButton">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.objbar.active TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.tx-pill">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector="Border.filter-row">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.filter-row.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="ComboBox.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="4,1,2,1" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
  </Style>
  <Style Selector="ComboBox.link.column">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ComboBox.link:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="TextBox.filter-value">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.bar-icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.bar-icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.bar-icon:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Border.cell.modified">
    <Setter Property="Background" Value="#33E8590C" />
  </Style>
  <Style Selector="TextBlock.row-state">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.grid-statusbar TextBlock.error">
    <Setter Property="Foreground" Value="#B42318" />
  </Style>
  <!-- ═════════ Barra titolo e toolbar snella ═════════ -->
  <Style Selector="Menu.top-menu > MenuItem">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="Button.tb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7,7,2,2" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.tb:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.tb.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tb.active /template/ ContentPresenter, Button.tb.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.tb.primary">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tb:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Border.tb-sep">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tb-icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tb-icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ═════════ Icone ═════════ -->
  <Style Selector="c|NfIcon.objbar-icon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector=":disabled c|NfIcon.objbar-icon">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="c|NfIcon.objbar-icon.active">
    <Setter Property="Fill" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="c|NfIcon.menu-icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="MenuItem:disabled c|NfIcon.menu-icon">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="c|NfIcon.tree-icon">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="StrokeWidth" Value="1.9" />
  </Style>
  <Style Selector="c|NfIcon.tree-icon.connection">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="c|NfIcon.tree-icon.connection.open">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBlock.tree-label.connection">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ═════════ Criteri di filtro ═════════ -->
  <Style Selector="Border.criteria-row">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Border.criteria-row.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.crit-chip">
    <Setter Property="Background" Value="#B7B2AC" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="15" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.crit-chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.crit-chip.remove:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#B42318" />
  </Style>
  <Style Selector="CheckBox.crit-check">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="CheckBox.crit-check:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.crit-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="3,1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.crit-link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.crit-link.operator, Button.crit-link.connector">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Margin" Value="2,0" />
  </Style>
  <Style Selector="Button.crit-link.connector">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TabControl.workspace TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox.crit-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="4,0,0,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.crit-link /template/ PathIcon#DropDownGlyph">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ComboBox.crit-link /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox.crit-link:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="ComboBox.crit-link.column">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox.crit-link.operator, ComboBox.crit-link.connector">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
  <Style Selector="TextBox.crit-value">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.crit-value /template/ TextBlock#PART_Watermark, TextBox.crit-value /template/ TextBlock#PART_FloatingWatermark">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox.crit-value:focus /template/ Border#PART_BorderElement, TextBox.crit-value:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.crit-value /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <!-- Pannello informazioni e interruttori pannelli -->
  <!-- Trascinamento nell'albero delle connessioni -->
  <Style Selector="TreeViewItem.drop-before /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,2,0,0" />
  </Style>
  <Style Selector="TreeViewItem.drop-after /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="TreeViewItem.drop-inside /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Progetta tabella: schede piatte e celle modificabili -->
  <Style Selector="RadioButton.design-tab">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bd" Background="Transparent" Padding="12,7,12,6" BorderThickness="0,0,0,2" BorderBrush="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.design-tab:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.design-tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.design-tab:checked /template/ Border#bd">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.cell-edit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.cell-edit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.cell-edit:pointerover /template/ Border#PART_BorderElement, TextBox.cell-edit:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ComboBox.cell-edit /template/ TextBox#PART_EditableTextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ComboBox.cell-edit /template/ ContentControl#ContentPresenter">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.cell-edit:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Selezione di riga intera (indicatore a sinistra) e di colonna (intestazione) -->
  <Style Selector="DataGrid.nf-grid.row-mode DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Opacity" Value="0.28" />
  </Style>
  <Style Selector="DataGrid.nf-grid.col-mode DataGridCell:current">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="DataGrid.nf-grid.row-mode DataGridCell:current">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridCell.col-selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="DataGrid.nf-grid DataGridCell.col-selected:current">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.header-sort:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
  </Style>

  <Style Selector="DataGrid.nf-grid.design-grid DataGridCell:current">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="ToggleButton.info-tab, ToggleButton.panel-toggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.info-tab:pointerover /template/ ContentPresenter, ToggleButton.panel-toggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.info-tab:checked /template/ ContentPresenter, ToggleButton.panel-toggle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.info-tab:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <!-- Autocompletamento SQL -->
  <Style Selector="c|NfIcon.completion-icon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="cc|CompletionList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <!-- Schede di contenuto, Server Monitor -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.monitor-server">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,8" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="Border.monitor-server.off">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TextBlock.mon-chip">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Margin" Value="0,0,10,1" />
  </Style>
  <Style Selector="Border.monitor-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.monitor-card.off">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="TextBlock.metric-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.long">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="#B42318" />
  </Style>
  <Style Selector="c|NfIcon.history-state">
    <Setter Property="Foreground" Value="#2E7D4F" />
  </Style>
  <Style Selector="c|NfIcon.history-state.error">
    <Setter Property="Foreground" Value="#B42318" />
  </Style>
  <Style Selector="c|NfIcon.objbar-icon.run">
    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.dense ListBoxItem">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
</Styles>